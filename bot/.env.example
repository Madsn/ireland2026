# Copy to .env and fill in. Never commit the real .env.

# Telegram bot token from @BotFather (message it /newbot).
TELEGRAM_BOT_TOKEN=123456789:AA...

# Comma-separated Telegram chat IDs allowed to use the bot — the 4 adults.
# To find yours: message the bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read message.chat.id
# REQUIRED. Empty = the bot refuses to start (it can edit + publish the wiki).
ALLOWED_CHAT_IDS=11111111,22222222

# Long-lived Claude Code auth from your Claude Pro plan. Generate on a machine
# with a browser:  claude setup-token  → outputs sk-ant-oat01-...  (valid ~1yr).
# This makes the bot's usage draw on your Pro subscription, NOT pay-per-token API.
# (If you instead set ANTHROPIC_API_KEY, it switches to API billing and wins.)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# The wiki clone the bot edits and pushes from. Defaults to the repo this file
# lives in; set explicitly in deployment.
# WIKI_REPO_DIR=/srv/ireland2026

# Seconds to allow per turn (edit + strict build + push). Optional.
# CLAUDE_TIMEOUT=600
